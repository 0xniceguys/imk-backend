# ── Training (excluded entirely — runs on server) ─────────────────────────────
training/

# ── Python runtime / build artifacts ──────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/
*.egg
*.jsonl

# ── Environment / secrets ──────────────────────────────────────────────────────
.env
*.env.local
*.pem
*.key

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/*.log
*.log

# ── Database ──────────────────────────────────────────────────────────────────
*.db
*.sqlite3

# ── Backend runtime outputs ────────────────────────────────────────────────────
streaming/web/
streaming/output/
hls_output/
vod_archive/
backend/alembic/versions/

# ── Emulator runtime ──────────────────────────────────────────────────────────
.m64p/

# ── ROM / binary game files (large, distribute separately) ────────────────────
*.z64
*.n64
*.rom
*.sfc
*.cue
*.bin

# ── Vendor compiled binaries ──────────────────────────────────────────────────
vendor/mupen64plus-core/build/
vendor/mupen64plus-ui-console/build/

# ── macOS ──────────────────────────────────────────────────────────────────────
.DS_Store

# ── Flutter (generated / build artifacts only — source is tracked) ────────────
streaming/flutter_app/.dart_tool/
streaming/flutter_app/.flutter-plugins
streaming/flutter_app/.flutter-plugins-dependencies
streaming/flutter_app/.packages
streaming/flutter_app/build/
# iOS CocoaPods build cache (not source)
streaming/flutter_app/ios/Pods/
streaming/flutter_app/ios/.symlinks/
# Android Gradle cache
streaming/flutter_app/android/.gradle/
streaming/flutter_app/android/local.properties
# flutter pub cache lock is committed (pubspec.lock stays)
mediasoup-server/  
