# Devnet RPC
SOLANA_URL=https://api.devnet.solana.com
ANCHOR_PROVIDER_URL=https://api.devnet.solana.com

# Paths (defaults are safe for this repo)
CONTRACTS_DIR=/home/ubuntu/imk/contracts
PROGRAM_DIR=/home/ubuntu/imk/contracts/skr_parimutuel_betting
KEYS_DIR=/home/ubuntu/imk/contracts/keys

# Key files
DEPLOYER_KEYPAIR=/home/ubuntu/imk/contracts/keys/devnet-deployer.json
ADMIN_KEYPAIR=/home/ubuntu/imk/contracts/keys/devnet-admin.json
TREASURY_KEYPAIR=/home/ubuntu/imk/contracts/keys/devnet-treasury.json

# Program metadata
PROGRAM_NAME=skr_parimutuel_betting
# Set after deploy (or pre-set if already known)
BETTING_PROGRAM_ID=

# Contract config values (required for init_config)
SKR_MINT=
MIN_BET_BASE_UNITS=
MAX_BET_BASE_UNITS=

# Treasury wallet. If empty, scripts derive from TREASURY_KEYPAIR.
TREASURY_WALLET=

# Deployment safety latch
DEPLOY_CONFIRM=NO
