[toolchain]

[features]
resolution = true
skip-lint = false

[programs.localnet]
skr_parimutuel_betting = "CYNWGYzvus1kSDGiwf8LQmegg5BLg15gyeXXySpAG41"

[registry]
url = "https://api.apr.dev"

[provider]
cluster = "Localnet"
wallet = "~/.config/solana/id.json"

[scripts]
test = "yarn run ts-mocha -p ./tsconfig.json -t 1000000 tests/**/*.ts"
